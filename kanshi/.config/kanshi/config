profile docked {
    output $HOME
    output eDP-1 disable
}

output 'Microstep MSI G32C4 0x00000166' {
    position 1920,0
    mode 1920x1080@143.9980
    scale 1.00
    transform normal
    alias $HOME
}

profile undocked {
    output eDP-1 enable position 0,0 mode 1920x1080@165.02 scale 1.00 transform normal
}
