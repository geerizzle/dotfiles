# swaylock-effects config. Generated by pywal from ~/.config/wal/templates/swaylock.
# Edit the template, not this file. The rendered copy lives in ~/.cache/wal/swaylock.
image=/home/duduya/.cache/wal/lock-wallpaper
scaling=fill
color=000000
effect-blur=10x3

indicator
indicator-radius=110
clock
timestr=%H:%M
datestr=%a, %d %b
font=GoogleSansCode Nerd Font

# Colors from the wallpaper (RRGGBB[AA])
inside-color={background.strip}aa
inside-clear-color={background.strip}aa
inside-ver-color={background.strip}aa
inside-wrong-color={background.strip}aa
ring-color={color4.strip}
ring-clear-color={color6.strip}
ring-ver-color={color2.strip}
ring-wrong-color=f53c3c
key-hl-color={foreground.strip}
bs-hl-color={color1.strip}
text-color={foreground.strip}
text-clear-color={foreground.strip}
text-ver-color={foreground.strip}
text-wrong-color=f53c3c
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000
